# Skopiuj do .env (który jest w .gitignore) i uzupełnij sekretami.
# Generuj długie, losowe wartości: `openssl rand -hex 32`

POSTGRES_PASSWORD=change-me-strong-random-string

# Klucze Nakama — KAŻDY powinien być inny, długi, losowy
SESSION_ENCRYPTION_KEY=change-me-32-chars-or-longer-random
SESSION_REFRESH_ENCRYPTION_KEY=change-me-32-chars-or-longer-random
SERVER_KEY=change-me-shared-with-client
CONSOLE_PASSWORD=change-me-admin-pass
